{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf --no-preserve-root /)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(sudo rm -rf *)",
      "Bash(sudo dd *)",
      "Bash(sudo chmod 777 *)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/)",
      "Bash(rm -rf /Users/cyril)",
      "Bash(rm -rf /Users/cyril/)",
      "Bash(rm -rf /home/cyril)",
      "Bash(rm -rf /home/cyril/)",
      "Bash(rm -rf /Applications*)",
      "Bash(rm -rf /Library*)",
      "Bash(rm -rf /System*)",
      "Bash(rm -rf /bin*)",
      "Bash(rm -rf /etc*)",
      "Bash(rm -rf /opt*)",
      "Bash(rm -rf /sbin*)",
      "Bash(rm -rf /usr*)",
      "Bash(rm -rf .)",
      "Bash(chmod 777 *)",
      "Bash(dd *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(git reset --hard *)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git clean -*f*)",
      "Bash(prisma migrate reset *)",
      "Bash(bunx prisma migrate reset *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(!.env.template)",
      "Read(~/.ssh/id_*)"
    ],
    "defaultMode": "auto"
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Source control: github.com/cmoron and all repos under it (Cyril's own repositories)"
    ],
    "allow": [
      "$defaults",
      "Merging a pull request in a github.com/cmoron repository is allowed once its CI checks pass: Cyril is the sole maintainer and delegates delivery to the agent"
    ]
  },
  "model": "fable",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/format-on-save.sh",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v atuin >/dev/null && atuin hook claude-code || true"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v atuin >/dev/null && atuin hook claude-code || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/protect-env.sh",
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/notify-sound.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input|agent_completed",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/notify-sound.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/scripts/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": false,
    "ponytail@ponytail": true,
    "clangd-lsp@claude-plugins-official": true,
    "codex@openai-codex": true,
    "swift-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "goblin-alertes@goblin-hood": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "goblin-hood": {
      "source": {
        "source": "directory",
        "path": "/home/cyril/src/goblin-hood/ops/claude"
      }
    }
  },
  "effortLevel": "medium",
  "pluginConfigs": {
    "ponytail@ponytail": {
      "options": {
        "ledger": false
      }
    }
  }
}
